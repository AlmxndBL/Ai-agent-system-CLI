# Active model provider: deepseek | gemini | claude | hermes
# (hermes = local Ollama, no API key needed — privacy/offline mode)
MODEL_PROVIDER=deepseek

# --- DeepSeek ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# --- Gemini (Google) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# --- Hermes (local Ollama, OpenAI-compatible) ---
# Requires Ollama running locally; no API key.
OLLAMA_BASE_URL=http://localhost:11434/v1
HERMES_MODEL=hermes4

# Obsidian Knowledge Graph Vault Path
OBSIDIAN_VAULT_PATH=./vault

# Directory for storing sessions (defaults to ~/.agent/sessions if not specified)
# SESSION_STORAGE_PATH=./.agent/sessions

# Telegram Gateway Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
OWNER_TELEGRAM_ID=your_telegram_user_id_here

# Security 2FA TOTP Configuration
# Use a 32-character base32 secret (e.g. JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP)
TOTP_SECRET=your_base32_totp_secret_here

# Token Compaction (Optional). If unset, the threshold defaults to each model's
# context window (claude ~200k, gemini ~1M, deepseek ~64k, hermes ~8k); compaction
# triggers at ~75% of this value.
# MAX_SESSION_TOKENS=25000
