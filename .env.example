# Model provider choice (google or deepseek)
MODEL_PROVIDER=deepseek

# Gemini API Key for Vercel AI SDK
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek Model selection (Optional, defaults to deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Obsidian Knowledge Graph Vault Path
OBSIDIAN_VAULT_PATH=./vault

# Directory for storing sessions (defaults to ~/.agent/sessions if not specified)
# SESSION_STORAGE_PATH=./.agent/sessions

# Telegram Gateway Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
OWNER_TELEGRAM_ID=your_telegram_user_id_here

# Security 2FA TOTP Configuration
# Use a 32-character base32 secret (e.g. JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP)
TOTP_SECRET=your_base32_totp_secret_here

# Token Compaction Settings
MAX_SESSION_TOKENS=25000
